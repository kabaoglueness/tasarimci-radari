# =============================================================================
# StudioFinder - Ortam Değişkenleri Şablonu (.env.example)
# =============================================================================
# BU DOSYA ÖRNEK ŞABLONDUR. KİŞİSEL BİLGİ VEYA GERÇEK ANAHTAR İÇERMEZ.
# GitHub'a güvenle gönderilebilir.
#
# Yerel kullanım için:
# Bu dosyayı '.env' adıyla kopyalayın ve gerekirse anahtarlarınızı girin.
# '.env' dosyası .gitignore ile korunmaktadır, asla GitHub'a yüklenmez.
# =============================================================================

# Sunucu Yapılandırması
PORT=8090
HOST=0.0.0.0

# İsteğe Bağlı: Ücretsiz Harici İlan API Anahtarları (Boş bırakılırsa yerel scraper çalışır)
# RapidAPI JSearch: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# SerpApi Google Jobs: https://serpapi.com
SERPAPI_KEY=

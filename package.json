{
  "name": "tasarimci-radari",
  "version": "1.0.0",
  "description": "Freelance tasarımcılar ve kreatif ajanslar için İstanbul odaklı canlı müşteri ve iş fırsatı radarı.",
  "main": "index.html",
  "scripts": {
    "build": "node -e \"const fs=require('fs'); fs.mkdirSync('dist',{recursive:true}); ['index.html','favicon.svg','manifest.json'].forEach(f=>fs.copyFileSync(f,'dist/'+f)); fs.cpSync('src','dist/src',{recursive:true}); fs.cpSync('data','dist/data',{recursive:true});\"",
    "start": "python server.py",
    "test": "python -m unittest tests/test_security_and_api.py"
  },
  "keywords": [
    "design",
    "freelance",
    "radar",
    "leads",
    "istanbul"
  ],
  "author": "kabaoglueness",
  "license": "AGPL-3.0-or-later"
}
